# Template for .env — copy this file to .env and fill in your own values.
# The real .env is gitignored and must never be committed or shared.
# Evidence for the workshop must stay free of secrets.

# Supabase dashboard -> Settings -> Database -> Session pooler (port 5432)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Signing secret for workshop JWTs. Generate your own random value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never commit or share the real value.
JWT_SECRET=replace-with-a-32-byte-base64url-secret
JWT_ISSUER=backend-course-api
JWT_AUDIENCE=backend-course-client
JWT_TTL_SECONDS=3600

# Exact origin of the frontend allowed by CORS (deliverable 05A).
FRONTEND_ORIGIN=http://localhost:5173
